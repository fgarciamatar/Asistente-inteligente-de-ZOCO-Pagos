        "jsCode": "const entrada = $('Parametrizacion chatInput').first().json;\n\nconst intencion =\n  $('Agente de precios').isExecuted     ? 'precios'   :\n  $('Agente').isExecuted                ? 'consultas' :\n  $('Respuesta Contacto').isExecuted    ? 'humano'    :\n                                        'otro';\n\nconst derivado =\n  $('Derivar a asesor').isExecuted ||\n  $('Derivar a asesor1').isExecuted ||\n  $('Registrar Derivacion').isExecuted;\n\nconst i = $input.first().json;\n\n// Función que escapa todos los caracteres especiales que exige Telegram MarkdownV2\nfunction escapeMarkdownV2(text) {\n  if (!text) return '';\n  // Escapa los caracteres reservados: _ * [ ] ( ) ~ ` > # + - = | { } . !\n  return text.replace(/[_*[\\]()~`>#+\\-=|{}.!]/g, '\\\\$&');\n}\n\nreturn [{\n  json: {\n    session_id: entrada.sessionId || 'sin-sesion',\n    canal: $('Webhook').isExecuted ? 'api' : 'chat',\n    intencion,\n    pregunta: entrada.chatInput,\n    respuesta: escapeMarkdownV2(i.output || i.text || i.respuesta || ''),\n    derivado\n  }\n}];"
      },
