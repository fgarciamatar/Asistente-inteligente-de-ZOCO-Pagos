    {
      "parameters": {
        "jsCode": "// Extrae el texto del Structured Output Parser para que el chat lo lea\nconst item = items[0].json;\nlet textResponse = \"\";\n\n// Verifica si viene dentro de la clave que definimos u otro formato\nif (item.respuesta_cliente) {\n    textResponse = item.respuesta_cliente;\n} else if (typeof item.output === 'string') {\n    textResponse = item.output;\n} else if (item.output && item.output.respuesta_cliente) {\n    textResponse = item.output.respuesta_cliente;\n} else {\n    textResponse = JSON.stringify(item);\n}\n\nreturn [{ json: { text: textResponse } }];"
